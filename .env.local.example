# ── Neon Auth (Better Auth) ───────────────────────────────────────────────────
# The Vercel–Neon integration sets VITE_NEON_AUTH_URL automatically.
# If running locally, set either one:
NEON_AUTH_BASE_URL=
# VITE_NEON_AUTH_URL=   # alternative — picked up automatically if set

# ── Neon Database ─────────────────────────────────────────────────────────────
# Use the pooled connection string from: Neon Console → your project → Connection Details
DATABASE_URL=

# ── Telegram bot (optional) ───────────────────────────────────────────────────
# Only needed if you run the review bot. Create a bot with @BotFather.
# The token is the master secret: anyone holding it can read every update,
# send as the bot, and impersonate linked users. Never commit it.
TELEGRAM_BOT_TOKEN=
# Without the leading @. Used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
# Random value passed to setWebhook as secret_token; Telegram echoes it back on
# every update, which is what proves an update really came from Telegram.
# Telegram allows only A-Za-z0-9_- here, so generate hex rather than base64.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Bearer token the reminder cron must present to /api/telegram/cron.
# Generate with: openssl rand -hex 32
TELEGRAM_CRON_SECRET=
# Public base URL of this deployment, used in bot messages and deep links.
APP_URL=

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# Development convenience: /api/claude falls back to this and the key screen is
# skipped, so you don't paste a key in on every fresh browser profile. A key a
# user enters themselves still takes precedence.
# Read in development only — NODE_ENV=production ignores it, so setting it on a
# deployment does nothing. A deployed fallback would be spent by whoever is
# signed in rather than by whoever owns it.
ANTHROPIC_API_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Fraction of requests that carry a performance transaction, 0–1. Defaults to
# 1 in development and 0.1 in production; raise it temporarily when you are
# investigating something. The NEXT_PUBLIC_ copy is the browser's, and is
# inlined at build time rather than read at runtime.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
