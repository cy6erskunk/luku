# ── Neon Auth (Better Auth) ───────────────────────────────────────────────────
# The Vercel–Neon integration sets VITE_NEON_AUTH_URL automatically.
# If running locally, set either one:
NEON_AUTH_BASE_URL=
# VITE_NEON_AUTH_URL=   # alternative — picked up automatically if set

# ── Neon Database ─────────────────────────────────────────────────────────────
# Use the pooled connection string from: Neon Console → your project → Connection Details
DATABASE_URL=

# ── Telegram bot (optional) ───────────────────────────────────────────────────
# Only needed if you run the review bot. Create a bot with @BotFather.
# The token is the master secret: anyone holding it can read every update,
# send as the bot, and impersonate linked users. Never commit it.
TELEGRAM_BOT_TOKEN=
# Without the leading @. Used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
# Random value passed to setWebhook as secret_token; Telegram echoes it back on
# every update, which is what proves an update really came from Telegram.
# Generate with: openssl rand -base64 32
TELEGRAM_WEBHOOK_SECRET=
# Bearer token the reminder cron must present to /api/telegram/cron.
TELEGRAM_CRON_SECRET=
# Public base URL of this deployment, used in bot messages and deep links.
APP_URL=

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# Set this for a personal deployment where you don't want users entering their own key.
# If unset, users enter their own key in the UI.
ANTHROPIC_API_KEY=
